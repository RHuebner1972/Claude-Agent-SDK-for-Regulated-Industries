# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Or use a cloud provider instead of the Claude API (see Module 10):
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1
SENTINEL_AUDIT_DIR=./.audit
# HMAC key that signs audit-log checkpoints (Module 3). Demo value only: in production this
# lives in a secrets manager or KMS, held by a team that can't edit the logs.
AUDIT_HMAC_KEY=course-demo-key
# Token vault keys (Module 4). Demo values only: generate your own with
#   uv run python -c "from sentinel.privacy import new_keys; print(new_keys())"
# and keep production keys in a KMS, held by a team separate from the vault's consumers.
VAULT_ENC_KEY=-Uy-ScvZo6q_h-S4bpRwdIU26Fk-Bo4eDb2vC6iVUr0=
VAULT_HMAC_KEY=course-demo-vault-hmac-key
PSEUDONYM_KEY=course-demo-pseudonym-key
# spaCy model for detection: en_core_web_sm (fast, default) or en_core_web_lg (finds more names)
PRIVACY_SPACY_MODEL=en_core_web_sm

# Module 6: signs approval records (HMAC). Use a key from your KMS in production.
APPROVAL_SIGNING_KEY=course-demo-signing-key
